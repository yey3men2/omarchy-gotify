#!/bin/bash

set -euo pipefail

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/gotify"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-gotify"
config_file="$config_dir/config.json"
state_file="$state_dir/state.json"
lock_file="$state_dir/poll.lock"
icon_dir="$state_dir/icons"
plugin_dir=$(cd "$(dirname "$0")/.." && pwd)
catch_up_after_seconds=90
max_critical_catch_up=2
backlog_page_size=100
backlog_max_pages=100

mkdir -p "$config_dir" "$state_dir" "$icon_dir"
chmod 700 "$config_dir" "$state_dir" "$icon_dir"

read_config() {
  [[ -s $config_file ]] || return 1
  server=$(jq -er '.server | select(type == "string" and length > 0)' "$config_file") || return 1
  token=$(jq -er '.token | select(type == "string" and length > 0)' "$config_file") || return 1
  server=${server%/}
  show_connection_indicator=$(jq -r 'if has("showConnectionIndicator") then .showConnectionIndicator else true end' "$config_file" 2>/dev/null || echo true)
  show_unread_indicator=$(jq -r 'if has("showUnreadIndicator") then .showUnreadIndicator else true end' "$config_file" 2>/dev/null || echo true)
  notifications_enabled=$(jq -r 'if has("notificationsEnabled") then .notificationsEnabled else true end' "$config_file" 2>/dev/null || echo true)
  catch_up_enabled=$(jq -r 'if has("catchUpEnabled") then .catchUpEnabled else true end' "$config_file" 2>/dev/null || echo true)
  max_individual_notifications=$(jq -r 'if has("maxIndividualNotifications") then .maxIndividualNotifications else 5 end' "$config_file" 2>/dev/null || echo 5)
  [[ $max_individual_notifications =~ ^[0-9]+$ ]] || max_individual_notifications=5
  (( max_individual_notifications >= 1 && max_individual_notifications <= 20 )) || max_individual_notifications=5
  message_fetch_limit=$(jq -r 'if has("messageFetchLimit") then .messageFetchLimit else 100 end' "$config_file" 2>/dev/null || echo 100)
  case $message_fetch_limit in
    25|50|100|200|500) ;;
    *) message_fetch_limit=100 ;;
  esac
}

curl_authenticated() {
  local auth_token=$1
  shift
  printf 'X-Gotify-Key: %s\n' "$auth_token" | curl --header @- "$@"
}

api_message_page() {
  local since=${1:-0} limit=${2:-100}
  curl_authenticated "$token" --fail --silent --show-error --max-time 12 --get \
    --data-urlencode "limit=$limit" \
    --data-urlencode "since=$since" \
    "$server/message"
}

api_messages() {
  local target=$message_fetch_limit cursor=0 page page_count=0 count=0 next_cursor request_limit
  local collected_file
  collected_file=$(mktemp "$state_dir/.messages.XXXXXX")
  chmod 600 "$collected_file"
  while (( count < target )); do
    request_limit=$((target - count))
    (( request_limit > backlog_page_size )) && request_limit=$backlog_page_size
    page=$(api_message_page "$cursor" "$request_limit") || { rm -f "$collected_file"; return 1; }
    jq -c '.messages[]?' <<<"$page" >>"$collected_file"
    count=$(wc -l <"$collected_file")
    next_cursor=$(jq -r '.paging.since // 0' <<<"$page")
    [[ $next_cursor =~ ^[0-9]+$ ]] || { rm -f "$collected_file"; return 1; }
    (( next_cursor > 0 && next_cursor != cursor )) || break
    cursor=$next_cursor
    ((page_count += 1))
    (( page_count <= 5 )) || { rm -f "$collected_file"; return 1; }
  done
  jq -sc --argjson target "$target" \
    '{messages:(unique_by(.id) | sort_by(.id) | reverse | .[:$target])}' "$collected_file"
  rm -f "$collected_file"
}

# Gotify's `since` parameter walks backward through older messages. Polling must
# therefore collect pages until it reaches the last processed ID; otherwise a
# backlog larger than the inbox display limit would be silently skipped.
api_messages_since() {
  local last_id=$1 cursor=0 page page_count=0 page_size next_cursor
  local collected_file
  collected_file=$(mktemp "$state_dir/.backlog.XXXXXX")
  chmod 600 "$collected_file"

  while (( page_count < backlog_max_pages )); do
    page=$(api_message_page "$cursor" "$backlog_page_size") || { rm -f "$collected_file"; return 1; }
    page_size=$(jq '.messages | length' <<<"$page")
    (( page_size > 0 )) || break
    jq -c '.messages[]?' <<<"$page" >>"$collected_file"

    if jq -e --argjson last "$last_id" 'any(.messages[]?; .id <= $last)' <<<"$page" >/dev/null; then
      break
    fi
    next_cursor=$(jq -r '.paging.since // 0' <<<"$page")
    [[ $next_cursor =~ ^[0-9]+$ ]] || { rm -f "$collected_file"; return 1; }
    (( next_cursor > 0 && next_cursor != cursor )) || break
    cursor=$next_cursor
    ((page_count += 1))
  done

  (( page_count < backlog_max_pages )) || {
    rm -f "$collected_file"
    printf 'Gotify backlog exceeds the safe pagination limit\n' >&2
    return 1
  }
  jq -sc --argjson last "$last_id" \
    '{messages:(map(select(.id > $last)) | unique_by(.id) | sort_by(.id))}' "$collected_file"
  rm -f "$collected_file"
}

api_applications() {
  curl_authenticated "$token" --fail --silent --show-error --max-time 12 --get \
    "$server/application"
}

write_state() {
  local last_id=$1 online=$2 error=${3:-} unread=${4:-0} locked=${5:-false}
  local tmp now last_success=""
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [[ -s $state_file ]]; then
    last_success=$(jq -r '.lastSuccessAt // .checkedAt // ""' "$state_file" 2>/dev/null || true)
  fi
  [[ $online == true ]] && last_success=$now
  tmp=$(mktemp "$state_dir/.state.XXXXXX")
  jq -n --argjson lastId "$last_id" --argjson online "$online" --argjson unread "$unread" \
    --argjson locked "$locked" \
    --arg checkedAt "$now" --arg lastSuccessAt "$last_success" --arg error "$error" \
    '{lastId:$lastId,online:$online,unread:$unread,checkedAt:$checkedAt,
      lastSuccessAt:$lastSuccessAt,error:$error,locked:$locked}' >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$state_file"
}

session_locked() {
  if [[ -n ${GOTIFY_LOCK_STATE:-} ]]; then
    [[ $GOTIFY_LOCK_STATE == true ]]
    return
  fi
  command -v omarchy-shell >/dev/null 2>&1 || return 1
  [[ $(omarchy-shell lock isLocked 2>/dev/null || printf false) == true ]]
}

log_event() {
  logger -t omarchy-gotify -- "$*" 2>/dev/null || true
}

application_icon() {
  local app_id=$1 applications=$2 image icon_path tmp
  image=$(jq -r --argjson appId "$app_id" \
    '.[]? | select(.id == $appId) | .image // empty' <<<"$applications" | head -n 1)
  [[ -n $image && $image != /* && $image != *[[:space:]]* ]] || return 1

  icon_path="$icon_dir/$app_id"
  if [[ ! -s $icon_path ]]; then
    tmp=$(mktemp "$icon_dir/.icon.XXXXXX")
    if ! curl_authenticated "$token" --fail --silent --show-error --max-time 12 \
      --max-filesize 2097152 --remove-on-error --output "$tmp" "$server/$image" || [[ ! -s $tmp ]]; then
      return 1
    fi
    chmod 600 "$tmp"
    mv "$tmp" "$icon_path"
  fi
  printf '%s\n' "$icon_path"
}

notify_message() {
  local item=$1 applications=$2 title body priority click_url urgency app_id app_icon
  title=$(jq -r '.title // "Gotify"' <<<"$item")
  body=$(jq -r '.message // ""' <<<"$item")
  priority=$(jq -r '.priority // 0' <<<"$item")
  app_id=$(jq -r '.appid // 0' <<<"$item")
  click_url=$(jq -r '.extras["client::notification.click"].url // empty' <<<"$item")
  [[ $click_url =~ ^https?://[^[:space:]]+$ ]] || click_url="$server"
  urgency=normal
  (( priority >= 8 )) && urgency=critical
  (( priority <= 1 )) && urgency=low
  app_icon=$(application_icon "$app_id" "$applications" 2>/dev/null || true)
  if [[ -n $app_icon ]]; then
    omarchy-notification-send --app-name Gotify -i "$app_icon" -u "$urgency" \
      "$title" "$body" --exec xdg-open "$click_url"
  else
    omarchy-notification-send --app-name Gotify -g "󰊪" -u "$urgency" \
      "$title" "$body" --exec xdg-open "$click_url"
  fi
}

notify_catch_up() {
  local items=$1 applications=$2 count summary
  count=$(jq 'length' <<<"$items")
  summary=$(jq -r --argjson apps "$applications" '
    ($apps | map({key:(.id|tostring), value:(.name // ("App " + (.id|tostring)))}) | from_entries) as $names |
    group_by(.appid) | map({name:($names[(.[0].appid|tostring)] // ("App " + (.[0].appid|tostring))), count:length}) |
    sort_by(-.count, .name) | .[:3] |
    map(.name + " (" + (.count|tostring) + ")") | join(", ")' <<<"$items")
  [[ -n $summary ]] || summary="Open Gotify to review them."
  omarchy-notification-send --app-name Gotify -i "$plugin_dir/assets/gotify-banner.png" -u normal \
    "$count Gotify messages received while away" "$summary" --exec xdg-open "$server"
}

poll() {
  read_config || exit 0
  exec 9>"$lock_file"
  flock -n 9 || exit 0

  local last_id=0 unread=0 payload applications error max_id new_count initialized=false
  local last_success_at="" last_success_epoch=0 now_epoch gap_seconds=0 catch_up=false new_items critical_items
  local was_locked=false currently_locked=false
  if [[ -s $state_file ]]; then
    last_id=$(jq -r '.lastId // 0' "$state_file" 2>/dev/null || echo 0)
    unread=$(jq -r '.unread // 0' "$state_file" 2>/dev/null || echo 0)
    last_success_at=$(jq -r '.lastSuccessAt // .checkedAt // ""' "$state_file" 2>/dev/null || true)
    was_locked=$(jq -r '.locked // false' "$state_file" 2>/dev/null || echo false)
  else
    initialized=true
  fi

  if [[ $initialized == true ]]; then
    if ! payload=$(api_messages 0 2>&1); then
      error=$(tail -n 1 <<<"$payload")
      write_state 0 false "$error" 0 false
      log_event "poll failed during initialization"
      exit 0
    fi
    max_id=$(jq '[.messages[]?.id // 0] | max // 0' <<<"$payload")
    write_state "$max_id" true "" 0 false
    log_event "initialized at message $max_id"
    exit 0
  fi

  if ! payload=$(api_messages_since "$last_id" 2>&1); then
    error=$(tail -n 1 <<<"$payload")
    write_state "$last_id" false "$error" "$unread" "$was_locked"
    log_event "poll failed; retaining message $last_id"
    exit 0
  fi

  max_id=$(jq '[.messages[]?.id // 0] | max // 0' <<<"$payload")

  session_locked && currently_locked=true
  if [[ $currently_locked == true ]]; then
    # Keep lastId and unread unchanged. The same messages remain pending and
    # will be summarized once the session unlocks, without duplicate counting.
    write_state "$last_id" true "" "$unread" true
    if (( max_id > last_id )) && [[ $was_locked != true ]]; then
      log_event "holding messages while session is locked"
    fi
    exit 0
  fi

  new_items=$(jq -c --argjson last "$last_id" '[.messages[]? | select(.id > $last)] | sort_by(.id)' <<<"$payload")
  new_count=$(jq 'length' <<<"$new_items")
  unread=$((unread + new_count))

  if [[ $notifications_enabled == true && $new_count -gt 0 ]]; then
    applications=$(api_applications 2>/dev/null || echo '[]')
    now_epoch=$(date +%s)
    if [[ -n $last_success_at ]]; then
      last_success_epoch=$(date -d "$last_success_at" +%s 2>/dev/null || echo 0)
      (( last_success_epoch > 0 && now_epoch > last_success_epoch )) && gap_seconds=$((now_epoch - last_success_epoch))
    fi
    if [[ $catch_up_enabled == true ]]; then
      if [[ $was_locked == true && $new_count -gt 1 ]] || \
          (( (gap_seconds > catch_up_after_seconds && new_count > 1) ||
             new_count > max_individual_notifications )); then
        catch_up=true
      fi
    fi

    if [[ $catch_up == true ]]; then
      critical_items=$(jq -c --argjson limit "$max_critical_catch_up" \
        '[.[] | select((.priority // 0) >= 8)][: $limit]' <<<"$new_items")
      while IFS= read -r item; do
        [[ -n $item ]] && notify_message "$item" "$applications"
      done < <(jq -c '.[]' <<<"$critical_items")
      notify_catch_up "$new_items" "$applications"
      log_event "sent catch-up summary for $new_count messages"
    else
      while IFS= read -r item; do
        [[ -n $item ]] && notify_message "$item" "$applications"
      done < <(jq -c '.[]' <<<"$new_items")
      log_event "sent $new_count individual notification(s)"
    fi
  fi

  (( max_id < last_id )) && max_id=$last_id
  write_state "$max_id" true "" "$unread" false
}

messages() {
  if ! read_config; then
    jq -n '{configured:false,messages:[]}'
    return
  fi
  local payload applications
  if ! payload=$(api_messages 0); then
    jq -n '{configured:true,messages:[]}'
    return
  fi
  applications=$(api_applications 2>/dev/null || echo '[]')
  jq -n --arg server "$server" \
    --slurpfile payload <(printf '%s\n' "$payload") \
    --slurpfile applications <(printf '%s\n' "$applications") '
    ($applications[0] | map({key:(.id|tostring), value:.}) | from_entries) as $apps |
    {configured:true,
     applications:[$applications[0][]? | {id, name:(.name // ("App " + (.id|tostring))),
       description:(.description // ""),
       iconUrl:(if (.image // "") == "" then "" else ($server + "/" + .image) end)}]
       | sort_by(.name),
     messages:[$payload[0].messages[]? |
      ($apps[(.appid|tostring)] // {}) as $app | {
        id, appId:.appid, appName:($app.name // ("App " + (.appid|tostring))),
        iconUrl:(if ($app.image // "") == "" then "" else ($server + "/" + $app.image) end),
        title:(.title // "Gotify"), message:(.message // ""),
        date:(.date // ""), priority:(.priority // 0),
        clickUrl:(.extras["client::notification.click"].url // $server)
      }] | sort_by(.id) | reverse}'
}

mark_read() {
  read_config || exit 0
  exec 9>"$lock_file"
  flock 9
  local last_id=0 online=true error=""
  if [[ -s $state_file ]]; then
    last_id=$(jq -r '.lastId // 0' "$state_file" 2>/dev/null || echo 0)
    online=$(jq -r '.online // true' "$state_file" 2>/dev/null || echo true)
    error=$(jq -r '.error // ""' "$state_file" 2>/dev/null || true)
  fi
  local locked=false
  locked=$(jq -r '.locked // false' "$state_file" 2>/dev/null || echo false)
  write_state "$last_id" "$online" "$error" 0 "$locked"
}

open_message() {
  local wanted=${1:-}
  read_config || exit 1
  [[ $wanted =~ ^[0-9]+$ ]] || exit 2
  local payload click_url
  payload=$(api_messages 0)
  click_url=$(jq -r --argjson wanted "$wanted" --arg server "$server" \
    '.messages[]? | select(.id == $wanted) | .extras["client::notification.click"].url // $server' \
    <<<"$payload" | head -n 1)
  [[ $click_url =~ ^https?://[^[:space:]]+$ ]] || click_url="$server"
  xdg-open "$click_url" >/dev/null 2>&1 &
}

status() {
  if ! read_config; then
    jq -n '{configured:false,online:false,message:"Gotify not configured"}'
    return
  fi
  local online=false checked="Never" error="" unread=0 locked=false
  if [[ -s $state_file ]]; then
    online=$(jq -r '.online // false' "$state_file" 2>/dev/null || echo false)
    checked=$(jq -r '.checkedAt // "Never"' "$state_file" 2>/dev/null || echo Never)
    error=$(jq -r '.error // ""' "$state_file" 2>/dev/null || true)
    unread=$(jq -r '.unread // 0' "$state_file" 2>/dev/null || echo 0)
    locked=$(jq -r '.locked // false' "$state_file" 2>/dev/null || echo false)
  fi
  if [[ $online == true ]]; then
    jq -n --arg checked "$checked" --argjson unread "$unread" --argjson locked "$locked" \
      --argjson showConnectionIndicator "$show_connection_indicator" \
      --argjson showUnreadIndicator "$show_unread_indicator" \
      --argjson notificationsEnabled "$notifications_enabled" \
      --argjson catchUpEnabled "$catch_up_enabled" \
      --argjson maxIndividualNotifications "$max_individual_notifications" \
      --argjson messageFetchLimit "$message_fetch_limit" \
      '{configured:true,online:true,unread:$unread,locked:$locked,showConnectionIndicator:$showConnectionIndicator,
        showUnreadIndicator:$showUnreadIndicator,notificationsEnabled:$notificationsEnabled,
        catchUpEnabled:$catchUpEnabled,maxIndividualNotifications:$maxIndividualNotifications,
        messageFetchLimit:$messageFetchLimit,
        message:("Gotify connected · " + $checked)}'
  else
    jq -n --arg error "$error" --argjson unread "$unread" --argjson locked "$locked" \
      --argjson showConnectionIndicator "$show_connection_indicator" \
      --argjson showUnreadIndicator "$show_unread_indicator" \
      --argjson notificationsEnabled "$notifications_enabled" \
      --argjson catchUpEnabled "$catch_up_enabled" \
      --argjson maxIndividualNotifications "$max_individual_notifications" \
      --argjson messageFetchLimit "$message_fetch_limit" \
      '{configured:true,online:false,unread:$unread,locked:$locked,showConnectionIndicator:$showConnectionIndicator,
        showUnreadIndicator:$showUnreadIndicator,notificationsEnabled:$notificationsEnabled,
        catchUpEnabled:$catchUpEnabled,maxIndividualNotifications:$maxIndividualNotifications,
        messageFetchLimit:$messageFetchLimit,
        message:(if $error == "" then "Gotify waiting for connection" else "Gotify: " + $error end)}'
  fi
}

setup() {
  local server_input token_input response tmp
  clear
  printf 'Gotify for Omarchy setup\n\n'
  printf 'Create a CLIENT token in Gotify first (not an application token).\n\n'
  read -r -p "Server URL (for example, https://gotify.example.com): " server_input
  server_input=${server_input%/}
  [[ $server_input =~ ^https?://[^[:space:]]+$ ]] || { printf 'Enter a valid HTTP or HTTPS URL.\n'; read -r -p 'Press Enter to close…'; exit 1; }
  read -r -s -p 'Client token: ' token_input
  printf '\nTesting connection…\n'
  [[ -n $token_input ]] || { printf 'Token cannot be empty.\n'; read -r -p 'Press Enter to close…'; exit 1; }
  [[ $token_input != *$'\n'* && $token_input != *$'\r'* ]] || { printf 'Token contains invalid characters.\n'; read -r -p 'Press Enter to close…'; exit 1; }
  if ! response=$(curl_authenticated "$token_input" --fail --silent --show-error --max-time 15 --get \
      --data-urlencode "limit=1" "$server_input/message" 2>&1); then
    printf 'Connection failed: %s\n' "$response"
    read -r -p 'Press Enter to close…'
    exit 1
  fi
  jq -e '.messages' >/dev/null <<<"$response" || { printf 'Unexpected response from server.\n'; read -r -p 'Press Enter to close…'; exit 1; }
  tmp=$(mktemp "$config_dir/.config.XXXXXX")
  jq -n --arg server "$server_input" --arg token "$token_input" \
    '{server:$server,token:$token,showConnectionIndicator:true,showUnreadIndicator:true,
      notificationsEnabled:true,catchUpEnabled:true,maxIndividualNotifications:5,messageFetchLimit:100}' >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$config_file"
  write_state "$(jq '[.messages[]?.id // 0] | max // 0' <<<"$response")" true "" 0
  printf '\nConnected. New Gotify messages will appear as Omarchy notifications.\n'
  read -r -p 'Press Enter to close…'
}

open_gotify() {
  if read_config; then xdg-open "$server" >/dev/null 2>&1 &
  else setup
  fi
}

show_config() {
  if read_config; then
    jq -n --arg server "$server" \
      --argjson showConnectionIndicator "$show_connection_indicator" \
      --argjson showUnreadIndicator "$show_unread_indicator" \
      --argjson notificationsEnabled "$notifications_enabled" \
      --argjson catchUpEnabled "$catch_up_enabled" \
      --argjson maxIndividualNotifications "$max_individual_notifications" \
      --argjson messageFetchLimit "$message_fetch_limit" \
      '{configured:true,server:$server,hasToken:true,showConnectionIndicator:$showConnectionIndicator,
        showUnreadIndicator:$showUnreadIndicator,notificationsEnabled:$notificationsEnabled,
        catchUpEnabled:$catchUpEnabled,maxIndividualNotifications:$maxIndividualNotifications,
        messageFetchLimit:$messageFetchLimit}'
  else
    jq -n '{configured:false,server:"",hasToken:false,showConnectionIndicator:true,showUnreadIndicator:true,
      notificationsEnabled:true,catchUpEnabled:true,maxIndividualNotifications:5,messageFetchLimit:100}'
  fi
}

configure() {
  local input server_input token_input existing_token="" response tmp
  local existing_connection=true existing_unread=true existing_notifications=true existing_catch_up=true existing_max=5 existing_fetch=100
  local connection_input unread_input notifications_input catch_up_input max_input fetch_input
  IFS= read -r input || input=""
  if ! server_input=$(jq -er '.server | select(type == "string" and length > 0)' <<<"$input" 2>/dev/null); then
    jq -n '{ok:false,message:"Enter a Gotify server URL."}'
    return 1
  fi
  token_input=$(jq -r '.token // ""' <<<"$input" 2>/dev/null || true)
  server_input=${server_input%/}
  if [[ ! $server_input =~ ^https?://[^[:space:]]+$ ]]; then
    jq -n '{ok:false,message:"Enter a valid HTTP or HTTPS Gotify URL."}'
    return 1
  fi
  if [[ -s $config_file ]]; then
    existing_token=$(jq -r '.token // ""' "$config_file" 2>/dev/null || true)
    existing_connection=$(jq -r 'if has("showConnectionIndicator") then .showConnectionIndicator else true end' "$config_file" 2>/dev/null || echo true)
    existing_unread=$(jq -r 'if has("showUnreadIndicator") then .showUnreadIndicator else true end' "$config_file" 2>/dev/null || echo true)
    existing_notifications=$(jq -r 'if has("notificationsEnabled") then .notificationsEnabled else true end' "$config_file" 2>/dev/null || echo true)
    existing_catch_up=$(jq -r 'if has("catchUpEnabled") then .catchUpEnabled else true end' "$config_file" 2>/dev/null || echo true)
    existing_max=$(jq -r '.maxIndividualNotifications // 5' "$config_file" 2>/dev/null || echo 5)
    existing_fetch=$(jq -r '.messageFetchLimit // 100' "$config_file" 2>/dev/null || echo 100)
  fi
  connection_input=$(jq -r --argjson fallback "$existing_connection" 'if has("showConnectionIndicator") then .showConnectionIndicator else $fallback end' <<<"$input")
  unread_input=$(jq -r --argjson fallback "$existing_unread" 'if has("showUnreadIndicator") then .showUnreadIndicator else $fallback end' <<<"$input")
  notifications_input=$(jq -r --argjson fallback "$existing_notifications" 'if has("notificationsEnabled") then .notificationsEnabled else $fallback end' <<<"$input")
  catch_up_input=$(jq -r --argjson fallback "$existing_catch_up" 'if has("catchUpEnabled") then .catchUpEnabled else $fallback end' <<<"$input")
  max_input=$(jq -r --argjson fallback "$existing_max" 'if has("maxIndividualNotifications") then .maxIndividualNotifications else $fallback end' <<<"$input")
  [[ $max_input =~ ^[0-9]+$ ]] && (( max_input >= 1 && max_input <= 20 )) || max_input=5
  fetch_input=$(jq -r --argjson fallback "$existing_fetch" 'if has("messageFetchLimit") then .messageFetchLimit else $fallback end' <<<"$input")
  case $fetch_input in 25|50|100|200|500) ;; *) fetch_input=100 ;; esac
  [[ -n $token_input ]] || token_input=$existing_token
  if [[ -z $token_input ]]; then
    jq -n '{ok:false,message:"Enter a Gotify client token."}'
    return 1
  fi
  if [[ $token_input == *$'\n'* || $token_input == *$'\r'* ]]; then
    jq -n '{ok:false,message:"The client token contains invalid characters."}'
    return 1
  fi
  if ! response=$(curl_authenticated "$token_input" --fail --silent --show-error --max-time 15 --get \
      --data-urlencode "limit=1" \
      "$server_input/message" 2>&1); then
    jq -n --arg message "Connection failed: $response" '{ok:false,message:$message}'
    return 1
  fi
  if ! jq -e '.messages' >/dev/null <<<"$response"; then
    jq -n '{ok:false,message:"The server returned an unexpected response."}'
    return 1
  fi
  tmp=$(mktemp "$config_dir/.config.XXXXXX")
  jq -n --arg server "$server_input" --arg token "$token_input" \
    --argjson showConnectionIndicator "$connection_input" --argjson showUnreadIndicator "$unread_input" \
    --argjson notificationsEnabled "$notifications_input" --argjson catchUpEnabled "$catch_up_input" \
    --argjson maxIndividualNotifications "$max_input" \
    --argjson messageFetchLimit "$fetch_input" \
    '{server:$server,token:$token,showConnectionIndicator:$showConnectionIndicator,
      showUnreadIndicator:$showUnreadIndicator,notificationsEnabled:$notificationsEnabled,
      catchUpEnabled:$catchUpEnabled,maxIndividualNotifications:$maxIndividualNotifications,
      messageFetchLimit:$messageFetchLimit}' >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$config_file"
  local newest
  newest=$(jq '[.messages[]?.id // 0] | max // 0' <<<"$response")
  write_state "$newest" true "" 0
  jq -n --arg server "$server_input" '{ok:true,server:$server,message:"Connected successfully."}'
}

save_preferences() {
  local input connection_input unread_input notifications_input catch_up_input max_input fetch_input tmp
  read_config || {
    jq -n '{ok:false,message:"Configure Gotify before changing preferences."}'
    return 1
  }
  IFS= read -r input || input=""
  connection_input=$(jq -er 'if (.showConnectionIndicator | type) == "boolean" then
      (.showConnectionIndicator | tostring) else error("invalid") end' <<<"$input" 2>/dev/null) || {
    jq -n '{ok:false,message:"Invalid connection-indicator setting."}'
    return 1
  }
  unread_input=$(jq -er 'if (.showUnreadIndicator | type) == "boolean" then
      (.showUnreadIndicator | tostring) else error("invalid") end' <<<"$input" 2>/dev/null) || {
    jq -n '{ok:false,message:"Invalid unread-indicator setting."}'
    return 1
  }
  notifications_input=$(jq -er 'if (.notificationsEnabled | type) == "boolean" then
      (.notificationsEnabled | tostring) else error("invalid") end' <<<"$input" 2>/dev/null) || {
    jq -n '{ok:false,message:"Invalid notification setting."}'
    return 1
  }
  catch_up_input=$(jq -er 'if (.catchUpEnabled | type) == "boolean" then
      (.catchUpEnabled | tostring) else error("invalid") end' <<<"$input" 2>/dev/null) || {
    jq -n '{ok:false,message:"Invalid catch-up setting."}'
    return 1
  }
  max_input=$(jq -er 'if (.maxIndividualNotifications | type) == "number"
      and (.maxIndividualNotifications | floor) == .maxIndividualNotifications
      and .maxIndividualNotifications >= 1 and .maxIndividualNotifications <= 20
      then (.maxIndividualNotifications | tostring) else error("invalid") end' <<<"$input" 2>/dev/null) || {
    jq -n '{ok:false,message:"Maximum individual notifications must be between 1 and 20."}'
    return 1
  }
  fetch_input=$(jq -er '.messageFetchLimit as $limit |
      if ($limit | type) == "number" and ([25,50,100,200,500] | index($limit)) != null
      then ($limit | tostring) else error("invalid") end' <<<"$input" 2>/dev/null) || {
    jq -n '{ok:false,message:"Invalid message fetch limit."}'
    return 1
  }
  tmp=$(mktemp "$config_dir/.config.XXXXXX")
  jq -n --arg server "$server" --arg token "$token" \
    --argjson showConnectionIndicator "$connection_input" --argjson showUnreadIndicator "$unread_input" \
    --argjson notificationsEnabled "$notifications_input" --argjson catchUpEnabled "$catch_up_input" \
    --argjson maxIndividualNotifications "$max_input" \
    --argjson messageFetchLimit "$fetch_input" \
    '{server:$server,token:$token,showConnectionIndicator:$showConnectionIndicator,
      showUnreadIndicator:$showUnreadIndicator,notificationsEnabled:$notificationsEnabled,
      catchUpEnabled:$catchUpEnabled,maxIndividualNotifications:$maxIndividualNotifications,
      messageFetchLimit:$messageFetchLimit}' >"$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$config_file"
  jq -n '{ok:true,message:"Notification preferences saved."}'
}

case ${1:-status} in
  poll) poll ;;
  status) status ;;
  messages) messages ;;
  mark-read) mark_read ;;
  open-message) open_message "${2:-}" ;;
  show-config) show_config ;;
  configure) configure ;;
  save-preferences) save_preferences ;;
  setup) setup ;;
  open) open_gotify ;;
  *) echo "Usage: ${0##*/} {poll|status|messages|mark-read|open-message ID|show-config|configure|save-preferences|setup|open}" >&2; exit 2 ;;
esac
